loop() {\n\n  if (digitalRead(select) == LOW) {\n    editMode =  (editMode + 1 ) % 3;\n    lcd.clear();\n    delay(300);\n  }\n  if (editMode == 1) {\n    min_Thr = analogRead(pot);\n    lcd.setCursor(0,0);\n    lcd.print(\"Set MIN\"); \n    lcd.print(min_Thr);\n    lcd.print(\"  \");\n    lcd.setCursor(0,1);\n    lcd.print(\"Press SAVE btn\");\n    if (digitalRead(save) == LOW) {\n      editMode=0;\n      lcd.clear();\n      delay(300);\n    }\n    delay(100);\n    return;\n  }\n\n  if (editMode == 2) {\n    max_Thr = analogRead(pot);\n    lcd.setCursor(0,0);\n    lcd.print(\"Set MAXIMUM\");\n    lcd.print(max_Thr);\n    lcd.print(\"  \");\n    lcd.setCursor(0,1);\n    lcd.print(\"Press SAVE btn\");\n    if (digitalRead(save) == LOW) {\n      editMode=0;\n      lcd.clear();\n      delay(300);\n    }\n    delay(100);\n    return;\n  }\n\n\n  int level = 0;\n  level = analogRead(WaterLevel);\n\n  int tempRaw = analogRead(temp);\n  temperature= (tempRaw*5.0*100.0)/1023.0;\n\n  Serial.println(level);\n  Serial.print(\"Temp: \");\n  Serial.println(temperature);\n  delay(200);\n\n  lcd.setCursor(0, 0);\n  lcd.print(\"Lvl:\");\n  lcd.print(level);\n  lcd.print(\"T:\");\n  lcd.print(temperature, 1);\n  lcd.print(\"C \");\n\n  lcd.setCursor(0, 1);\n\n  if (level < min_Thr){\n    \n    lcd.print(\"LOW  \");\n    digitalWrite(red, LOW);\n    digitalWrite(green, HIGH);\n    digitalWrite(blue, LOW);\n    digitalWrite(buzzer, LOW);\n\n  }\n  else if (level < max_Thr){\n\n    lcd.print(\"MEDIUM  \");\n    digitalWrite(red, LOW);\n    digitalWrite(green, LOW);\n    digitalWrite(blue, HIGH);\n    digitalWrite(buzzer, LOW);\n\n  }\n else {\n\n    lcd.print(\"FULL  \");\n    digitalWrite(red, HIGH);\n    digitalWrite(green, LOW);\n    digitalWrite(blue, LOW);\n    digitalWrite(buzzer, HIGH);   \n\n }\n  delay(100);\n\n\n}\n"}]},"components":[{"id":"water_level_sensor_1784102192863_t5lf8mxss","metadataId":"water-level-sensor","x":-744.7468245250651,"y":183.2880120657002,"properties":{